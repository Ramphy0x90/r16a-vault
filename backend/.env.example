# Local development settings for `cargo run`. Copy to .env, which git ignores.
# Values match deploy/compose/docker-compose.dev.yml and must never be used in production.

R16A_DATABASE_URL=postgres://r16a_app:app-dev-password@127.0.0.1:5432/r16a
R16A_MIGRATE_DATABASE_URL=postgres://r16a_owner:owner-dev-password@127.0.0.1:5432/r16a
R16A_MIGRATE_ON_START=true

# ng serve runs on 4200. The dockerised web app on 8080 is allowed as an extra origin.
R16A_PUBLIC_URL=http://localhost:4200
R16A_EXTRA_ORIGINS=http://localhost:8080
R16A_DEV_INSECURE_COOKIE=true

R16A_PRELOGIN_SECRET=dev-only-prelogin-secret-0123456789abcdef
R16A_AUTH_PEPPER=dev-only-auth-pepper-0123456789abcdefghij
R16A_BIND=127.0.0.1:8081
R16A_LOG_FORMAT=pretty
RUST_LOG=info,sqlx=warn,r16a_vault_backend=debug

# Compile queries against the committed .sqlx cache, so building needs no database.
# To refresh the cache after changing a query, run
#   DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/r16a cargo sqlx prepare -- --all-targets
SQLX_OFFLINE=true
