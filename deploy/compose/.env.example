# Copy to .env and replace every value. Generate secrets with `openssl rand -base64 48`.
POSTGRES_PASSWORD=change-me-postgres-superuser
R16A_OWNER_PASSWORD=change-me-schema-owner
R16A_APP_PASSWORD=change-me-runtime-role

# At least 32 characters each. The pepper is optional but recommended. Keep it outside
# database backups, and never change it later, because existing logins would stop working.
R16A_PRELOGIN_SECRET=
R16A_AUTH_PEPPER=

# Must match the address in the browser bar exactly, it is checked against Origin.
R16A_PUBLIC_URL=http://localhost:8080
R16A_HTTP_PORT=8080

# Only for plain HTTP on localhost. Set to false behind HTTPS.
R16A_DEV_INSECURE_COOKIE=true
R16A_REGISTRATION_ENABLED=true
